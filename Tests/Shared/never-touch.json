    { "path": "~/.ssh/id_ed25519", "expect": "refuse" },
    { "path": "~/.ssh/config", "expect": "refuse" },
    { "path": "~/.gnupg/pubring.kbx", "expect": "refuse" },
    { "path": "~/.aws/credentials", "expect": "refuse" },
    { "path": "~/.azure/msal_token_cache.json", "expect": "refuse" },
    { "path": "~/.kube/config", "expect": "refuse" },
    { "path": "~/Documents/old-laptop/.ssh/id_rsa", "expect": "refuse" },

    { "path": "~/Library/Keychains/login.keychain-db", "expect": "refuse", "platform": "macos" },
    { "path": "~/Library/Keychains/ABCD-1234/keychain-2.db", "expect": "refuse", "platform": "macos" },
    { "path": "~/library/keychains/login.keychain-db", "expect": "refuse", "platform": "macos" },
    { "path": "~/Documents/backup/login.keychain-db", "expect": "refuse", "platform": "macos" },
    { "path": "~/Library/Mail/V10/MailData/Envelope Index", "expect": "refuse", "platform": "macos" },
    { "path": "~/Library/Messages/chat.db", "expect": "refuse", "platform": "macos" },
    { "path": "~/Library/Accounts/Accounts4.sqlite", "expect": "refuse", "platform": "macos" },
