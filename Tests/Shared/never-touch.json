    { "path": "~/Documents/ssh-notes.txt", "expect": "allow" },
    { "path": "~/Documents/.sshx/notes.txt", "expect": "allow" },
    { "path": "~/Documents/Mail/draft.txt", "expect": "allow" },
    { "path": "~/Library/Caches/com.example.app", "expect": "allow", "platform": "macos" },
    { "path": "~/Library/Logs/Example", "expect": "allow", "platform": "macos" },
    { "path": "~/Library/Mailbox Exports/a.mbox", "expect": "allow", "platform": "macos" },
    { "path": "~/Library/Application Support/MobileSync/Backup/old", "expect": "allow", "platform": "macos" },
    { "path": "~/.npm/_cacache", "expect": "allow", "platform": "macos" },
