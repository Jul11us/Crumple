    { "path": "~/Pictures/Photos Library.photoslibrary/database/Photos.sqlite", "expect": "refuse", "platform": "macos" },
    { "path": "~/Library/Application Support/Crumple/history.json", "expect": "refuse", "platform": "macos" },

    { "path": "~/AppData/Roaming/Microsoft/Credentials/DFBE70A7E5CC19A3", "expect": "refuse", "platform": "windows" },
    { "path": "~/AppData/Local/Microsoft/Credentials/DFBE70A7E5CC19A3", "expect": "refuse", "platform": "windows" },
    { "path": "~/AppData/Roaming/Microsoft/Protect/S-1-5-21/key", "expect": "refuse", "platform": "windows" },
    { "path": "~/AppData/Local/Microsoft/Vault/4BF4C442/policy.vpol", "expect": "refuse", "platform": "windows" },
